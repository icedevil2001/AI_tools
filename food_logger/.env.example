# The app's public origin, used to build the magic-link return URL.
#
# Supabase silently falls back to the project's Site URL when this does not
# match an entry in its Redirect URLs allowlist, so it has to be a STABLE
# origin. On Vercel set this on the Production environment only -- left unset
# on Preview, each preview deployment signs in against itself instead of
# bouncing you to production.
#
# Leave blank for local development.
NEXT_PUBLIC_SITE_URL=

# Supabase (from your project's API settings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS -- never expose to the browser, never prefix with
# NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter. Server-only, same warning as above.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=openai/gpt-5.6-luna

# Optional: sent to OpenRouter for attribution in their dashboard.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=Food Logger
